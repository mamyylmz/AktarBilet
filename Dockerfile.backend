# Multi-stage non-root Go backend Dockerfile
FROM golang:1.23-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git ca-certificates

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-w -s" -o /app/server ./cmd/server
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-w -s" -o /app/verify ./cmd/verify

FROM alpine:3.20

RUN apk add --no-cache ca-certificates curl tzdata && \
    addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

COPY --from=builder /app/server /app/server
COPY --from=builder /app/verify /app/verify
COPY --from=builder /app/migrations /app/migrations

USER appuser

EXPOSE 8080

HEALTHCHECK --interval=5s --timeout=3s --retries=5 --start-period=5s \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["/app/server"]
