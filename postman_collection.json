{
  "info": {
    "name": "AktarBilet REST API Koleksiyonu",
    "_postman_id": "f85f2600-0000-4000-8000-000000000001",
    "description": "AktarBilet Şehir İçi Toplu Taşıma Bilet ve Ücretlendirme Sistemi REST API Koleksiyonu. Tüm demo hesaplar ve çalışma zamanı uç noktaları yapılandırılmıştır.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "yolcuToken", "value": "", "type": "string" },
    { "key": "kontrolorToken", "value": "", "type": "string" },
    { "key": "hatYoneticisiToken", "value": "", "type": "string" },
    { "key": "muhasebeToken", "value": "", "type": "string" },
    { "key": "operasyonToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Sistem & Sağlık",
      "item": [
        {
          "name": "Genel Sağlık Kontrolü",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        },
        {
          "name": "Gizli Sistem Sağlık Ucu (Canary 4)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/_hz/f85f", "host": ["{{baseUrl}}"], "path": ["_hz", "f85f"] }
          }
        },
        {
          "name": "Prometheus Metrikleri",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/metrics", "host": ["{{baseUrl}}"], "path": ["metrics"] }
          }
        }
      ]
    },
