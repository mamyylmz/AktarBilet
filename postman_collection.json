          "name": "Hatları Listele",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/lines", "host": ["{{baseUrl}}"], "path": ["api", "v1", "lines"] }
          }
        },
        {
          "name": "Yeni Hat Oluştur (Hat Yöneticisi)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{hatYoneticisiToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"LINE_888E\",\n  \"name\": \"888E Karşıyaka - Bornova Hızlı\",\n  \"mode\": \"bus\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/lines", "host": ["{{baseUrl}}"], "path": ["api", "v1", "lines"] }
          }
        },
        {
          "name": "Durakları Listele",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/stations", "host": ["{{baseUrl}}"], "path": ["api", "v1", "stations"] }
          }
        },
        {
          "name": "Tarifeleri Listele",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/tariffs", "host": ["{{baseUrl}}"], "path": ["api", "v1", "tariffs"] }
          }
        }
      ]
    },
    {
      "name": "5. F-2 / T-1 / T-2: Validatör Turnike Binişleri",
      "item": [
        {
          "name": "Turnike Biniş Olayı (HMAC İmzalı)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Validator-ID", "value": "VAL_500T_01" },
              { "key": "X-Device-Signature", "value": "device_hmac_signature" },
              { "key": "X-Device-Timestamp", "value": "1793033904" },
              { "key": "X-Device-Nonce", "value": "nonce_pm_tap_01" },
              { "key": "Idempotency-Key", "value": "PM_TAP_001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"validator_id\": \"VAL_500T_01\",\n  \"sequence_no\": 1,\n  \"card_id\": \"CARD_YOLCU_001\",\n  \"line_id\": \"LINE_500T\",\n  \"station_id\": \"STAT_AYRILIK\",\n  \"direction\": 1,\n  \"tapped_at\": \"2026-10-26T12:00:00Z\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/validators/tap", "host": ["{{baseUrl}}"], "path": ["api", "v1", "validators", "tap"] }
          }
        },
        {
          "name": "Çevrimdışı Toplu Paket Senkronizasyonu (Batch Sync)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Validator-ID", "value": "VAL_500T_01" },
              { "key": "X-Device-Signature", "value": "device_batch_hmac_signature" },
              { "key": "X-Device-Timestamp", "value": "1793033904" },
              { "key": "X-Device-Nonce", "value": "nonce_pm_batch_01" }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"idempotency_key\": \"PM_BATCH_EV_01\",\n    \"validator_id\": \"VAL_500T_01\",\n    \"sequence_no\": 10,\n    \"card_id\": \"CARD_YOLCU_001\",\n    \"line_id\": \"LINE_500T\",\n    \"station_id\": \"STAT_AYRILIK\",\n    \"direction\": 1,\n    \"tapped_at\": \"2026-10-26T12:01:00Z\"\n  }\n]"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/validators/batch-sync", "host": ["{{baseUrl}}"], "path": ["api", "v1", "validators", "batch-sync"] }
          }
        }
      ]
    },
