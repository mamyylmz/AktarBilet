    {
      "name": "3. F-1: Kart & Bakiye Yönetimi",
      "item": [
        {
          "name": "Kart Sorgula (IDOR korumalı)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{yolcuToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/cards/CARD_YOLCU_001", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cards", "CARD_YOLCU_001"] }
          }
        },
        {
          "name": "Kart Defter Hareketleri (Bonus 2)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{yolcuToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/cards/CARD_YOLCU_001/ledger", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cards", "CARD_YOLCU_001", "ledger"] }
          }
        },
        {
          "name": "Karta Bakiye Yükle (Idempotent)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{yolcuToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "POSTMAN_RECHARGE_001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount_kurus\": 10000,\n  \"description\": \"Postman Dolumu 100 TL\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/cards/CARD_YOLCU_001/recharge", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cards", "CARD_YOLCU_001", "recharge"] }
          }
        }
      ]
    },
    {
