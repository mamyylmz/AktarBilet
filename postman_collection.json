      "item": [
        {
          "name": "Sefer Sıklığı Simülasyonu",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{hatYoneticisiToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"line_id\": \"LINE_500T\",\n  \"current_headway_minutes\": 15,\n  \"target_headway_minutes\": 8,\n  \"fleet_capacity_per_vehicle\": 75,\n  \"peak_hour\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/optimization/headway-scenario", "host": ["{{baseUrl}}"], "path": ["api", "v1", "optimization", "headway-scenario"] }
          }
        },
        {
          "name": "Optimizasyon Onayla ve Kaydet",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{hatYoneticisiToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "PM_OPT_APP_001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"line_id\": \"LINE_500T\",\n  \"current_headway_minutes\": 15,\n  \"target_headway_minutes\": 8,\n  \"fleet_capacity\": 75,\n  \"vehicle_delta\": 4,\n  \"delta_cost_kurus\": 250000,\n  \"projected_net_margin_kurus\": 450000,\n  \"notes\": \"Pik saat sıklık artırımı\"\n}"
