FROM node:20-alpine AS builder

WORKDIR /app

COPY web/package.json ./
RUN npm install

COPY web/index.html web/vite.config.js ./
COPY web/public ./public
COPY web/src ./src
RUN npm run build

FROM nginx:1.27-alpine
ARG QA_BACKEND_HOST=backend

RUN addgroup -S appgroup && adduser -S appuser -G appgroup && \
    touch /var/run/nginx.pid && \
    chown -R appuser:appgroup /var/run/nginx.pid /var/cache/nginx /var/log/nginx /usr/share/nginx/html

COPY --from=builder /app/dist /usr/share/nginx/html

RUN printf '%s\n' \
    'server {' \
    '  listen 3000;' \
    '  location ~* \.pmtiles$ { root /usr/share/nginx/html; types { application/vnd.pmtiles pmtiles; } default_type application/vnd.pmtiles; add_header Accept-Ranges bytes; }' \
    '  location / { root /usr/share/nginx/html; index index.html; try_files $uri $uri/ /index.html; }' \
    "  location /api/ { proxy_pass http://${QA_BACKEND_HOST}:8080/api/; }" \
    "  location /_hz/ { proxy_pass http://${QA_BACKEND_HOST}:8080/_hz/; }" \
    "  location /health { proxy_pass http://${QA_BACKEND_HOST}:8080/health; }" \
    '}' > /etc/nginx/conf.d/default.conf

USER appuser
EXPOSE 3000
HEALTHCHECK --interval=2s --timeout=3s --retries=30 CMD wget -q -O /dev/null http://localhost:3000/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
