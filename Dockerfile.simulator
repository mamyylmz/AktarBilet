# Multi-stage non-root Simulator Dockerfile
FROM golang:1.23-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-w -s" -o /app/simulator ./cmd/simulator

FROM alpine:3.20

RUN apk add --no-cache ca-certificates curl tzdata && \
    addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

COPY --from=builder /app/simulator /app/simulator

USER appuser

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
    CMD ps aux | grep -v grep | grep -q simulator || exit 1

ENTRYPOINT ["/app/simulator"]
