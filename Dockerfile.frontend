# Multi-stage non-root Frontend Dockerfile
FROM node:20-alpine AS builder

WORKDIR /app

COPY web/package.json ./
RUN npm install

COPY web/index.html ./
COPY web/vite.config.js ./
COPY web/src ./src
RUN npm run build

FROM nginx:1.27-alpine

# Non-root nginx setup
RUN addgroup -S appgroup && adduser -S appuser -G appgroup && \
    touch /var/run/nginx.pid && \
    chown -R appuser:appgroup /var/run/nginx.pid /var/cache/nginx /var/log/nginx /usr/share/nginx/html

COPY --from=builder /app/dist /usr/share/nginx/html

# Custom nginx conf for SPA routing and proxying
RUN echo 'server { \
    listen 3000; \
    listen [::]:3000; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html; \
        try_files $uri $uri/ /index.html; \
    } \
    location /api/ { \
        proxy_pass http://backend:8080/api/; \
    } \
    location /_hz/ { \
        proxy_pass http://backend:8080/_hz/; \
    } \
    location /health { \
        proxy_pass http://backend:8080/health; \
    } \
}' > /etc/nginx/conf.d/default.conf

USER appuser

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:3000/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
